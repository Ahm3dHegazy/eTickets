@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <!-- Hero Header -->
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-3">
            <i class="bi bi-shield-check me-1"></i> Trust & Security
        </span>
        <h1 class="display-5 fw-bold text-gradient mb-3">Privacy Policy</h1>
        <p class="lead text-muted mx-auto" style="max-width: 650px;">
            At <strong>eTickets</strong>, your privacy is our top priority. Here is a transparent breakdown of how we handle and safeguard your personal data.
        </p>
        <p class="small text-muted">
            <i class="bi bi-clock me-1"></i> Last updated: August 2026
        </p>
    </div>

    <!-- Quick Navigation Pills -->
    <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">
        <a href="#collection" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-person-badge me-1"></i> Data Collection</a>
        <a href="#usage" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-gear-wide-connected me-1"></i> How We Use It</a>
        <a href="#payments" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-credit-card me-1"></i> Payments</a>
        <a href="#cookies" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-cookie me-1"></i> Cookies</a>
        <a href="#security" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-lock me-1"></i> Security</a>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- Section 1 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="collection">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle p-3 me-3">
                            <i class="bi bi-database-check fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold">1. Information We Collect</h4>
                    </div>
                    <p class="text-secondary mb-0">
                        When you create an account, purchase cinema tickets, or interact with our platform, we collect essential details such as your full name, email address, contact information, and purchase history to fulfill your ticket reservations.
                    </p>
                </div>
            </div>

            <!-- Section 2 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="usage">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-info-subtle text-info rounded-circle p-3 me-3">
                            <i class="bi bi-sliders fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold">2. How We Use Your Information</h4>
                    </div>
                    <ul class="text-secondary mb-0 ps-3">
                        <li class="mb-2">Process ticket bookings, reservations, and digital passes smoothly.</li>
                        <li class="mb-2">Send booking confirmations, updates regarding movie schedules, or venue alterations.</li>
                        <li class="mb-2">Provide dedicated customer support and handle refund requests.</li>
                        <li>Continuously optimize the <strong>eTickets</strong> performance and user experience.</li>
                    </ul>
                </div>
            </div>

            <!-- Section 3 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="payments">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-success-subtle text-success rounded-circle p-3 me-3">
                            <i class="bi bi-credit-card-2-front fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold">3. Payment & Security</h4>
                    </div>
                    <p class="text-secondary mb-0">
                        All transactions are processed through encrypted, industry-certified payment gateways (such as PayPal or Stripe). <strong>eTickets does not store or process complete credit card details</strong> on our local servers.
                    </p>
                </div>
            </div>

            <!-- Section 4 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="cookies">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-warning-subtle text-warning rounded-circle p-3 me-3">
                            <i class="bi bi-cookie fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold">4. Cookies & Session Management</h4>
                    </div>
                    <p class="text-secondary mb-0">
                        We use essential cookies to maintain your active login session, remember your shopping cart items, and save your preferred cinema locations. You can disable non-essential cookies via your browser settings at any time.
                    </p>
                </div>
            </div>

            <!-- Section 5 -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="security">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-danger-subtle text-danger rounded-circle p-3 me-3">
                            <i class="bi bi-shield-lock fs-4"></i>
                        </div>
                        <h4 class="mb-0 fw-bold">5. Data Protection & Rights</h4>
                    </div>
                    <p class="text-secondary mb-2">
                        We implement rigorous security standard safeguards (HTTPS encryption, ASP.NET Identity authentication mechanisms) to shield your data from unauthorized access.
                    </p>
                    <p class="text-secondary mb-0">
                        You reserve the right to access, update, or request the full deletion of your personal account data at any point through your Profile settings or by contacting our team.
                    </p>
                </div>
            </div>

            <!-- Contact Box -->
            <div class="card border-0 bg-primary text-white rounded-4 p-4 shadow mt-5">
                <div class="d-flex align-items-center flex-column flex-md-row text-center text-md-start">
                    <div class="mb-3 mb-md-0 me-md-4">
                        <i class="bi bi-headset display-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="fw-bold mb-1">Have questions about your privacy?</h4>
                        <p class="mb-0 text-white-50">Our support team is available to assist you with any data inquiries or account rights.</p>
                    </div>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-light rounded-pill px-4 py-2 mt-3 mt-md-0 fw-semibold text-primary">
                        Contact Us
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1); }
    .bg-info-subtle { background-color: rgba(13, 202, 240, 0.1); }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.15); }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1); }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    html {
        scroll-behavior: smooth;
    }
</style>