@inject eTickets.Business.Interfaces.IShoppingCartService CartService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eTickets</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eTickets.web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-dark mb-3" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand ms-3" asp-area="" asp-controller="Home" asp-action="Index">eTickets</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Index">Movies</a>
                        </li>

                        @if (User.IsInRole("Administrator"))
                        {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="managementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Management
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="managementDropdown">
                                <li><a class="dropdown-item" asp-controller="Actors" asp-action="Index">Actors</a></li>
                                <li><a class="dropdown-item" asp-controller="Cinemas" asp-action="Index">Cinemas</a></li>
                                <li><a class="dropdown-item" asp-controller="Producers" asp-action="Index">Producers</a></li>
                            </ul>
                        </li>
                        }
                    </ul>

                    <form class="d-flex me-3" asp-controller="Movies" asp-action="Search" method="get">
                        <div class="input-group">
                            <input type="text" name="query" class="form-control" placeholder="Search for a movie...">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <a asp-controller="ShoppingCart" asp-action="Index" class="nav-link position-relative text-white me-3">
                        <i class="bi bi-cart3 fs-5"></i>
                        @{
                            var cartCount = CartService.GetCount();
                        }
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @cartCount
                            </span>
                        }
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text text-white me-2">Hello, @(User.Identity.Name)</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    @* put this inside <body>, e.g. under the navbar *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="statusAlert"
             class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3 py-2 px-3 shadow"
             style="z-index: 1055; font-size: 0.9rem;"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>

        <script>
                setTimeout(function() {
                    var a = document.getElementById('statusAlert');
                    if (!a) return;
                    a.classList.remove('show');
                    setTimeout(function() { a.remove(); }, 200);
                }, 2000);
        </script>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - eTickets - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
