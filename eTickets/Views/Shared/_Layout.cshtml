@inject eTickets.Business.Interfaces.IShoppingCartService CartService
@using eTickets.Data.Enums

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] · eTickets</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cinema-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eTickets.web.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg cinema-nav" data-bs-theme="dark">
            <div class="container">

                <a class="navbar-brand brand-mark"
                   asp-controller="Home"
                   asp-action="Index">
                    <span>e</span>Tickets
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    <ul class="navbar-nav mx-lg-auto gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Movies"
                               asp-action="Index">
                                Movies
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="categoriesDropdown"
                               role="button"
                               data-bs-toggle="dropdown">
                                Categories
                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark"
                                aria-labelledby="categoriesDropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Movies"
                                       asp-action="Index">
                                        All movies
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                @foreach (var category in Enum.GetValues<MovieCategory>())
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Movies"
                                           asp-action="Index"
                                           asp-route-category="@category">
                                            <i class="bi bi-film me-2"></i>
                                            @category
                                        </a>
                                    </li>
                                }

                            </ul>
                        </li>

                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="managementDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown">
                                    Management
                                </a>

                                <ul class="dropdown-menu dropdown-menu-dark"
                                    aria-labelledby="managementDropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Actors"
                                           asp-action="Index">
                                            Actors
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Cinemas"
                                           asp-action="Index">
                                            Cinemas
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Producers"
                                           asp-action="Index">
                                            Producers
                                        </a>
                                    </li>

                                </ul>
                            </li>
                        }

                    </ul>

                    <div class="nav-utilities">

                        <form class="nav-search"
                              asp-controller="Movies"
                              asp-action="Search"
                              method="get">

                            <input type="search"
                                   name="query"
                                   placeholder="Search movies" />

                            <button type="submit">
                                <i class="bi bi-search"></i>
                            </button>

                        </form>

                        <a asp-controller="ShoppingCart"
                           asp-action="Index"
                           class="nav-cart">

                            <i class="bi bi-bag"></i>

                            @{
                                var cartCount = CartService.GetCount();
                            }

                            @if (cartCount > 0)
                            {
                                <span>@cartCount</span>
                            }

                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-login"
                               asp-controller="Account"
                               asp-action="Profile">
                                <i class="bi bi-person-circle"></i>
                                Profile
                            </a>

                            <a class="nav-login"
                               asp-controller="Orders"
                               asp-action="MyOrders">
                                <i class="bi bi-ticket-perforated"></i>
                                My orders
                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-link nav-signout">
                                    Sign out
                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="nav-login"
                               asp-controller="Account"
                               asp-action="Login">
                                Sign in
                            </a>

                            <a class="btn btn-cinema btn-sm"
                               asp-controller="Account"
                               asp-action="Register">
                                Join now
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null ||
         TempData["StatusMessage"] != null)
    {
        <div class="cinema-toast">
            <i class="bi bi-check2-circle"></i>
            @(TempData["SuccessMessage"] ?? TempData["StatusMessage"])
        </div>
    }

    <main role="main" class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container footer-content">

            <a class="brand-mark"
               asp-controller="Home"
               asp-action="Index">
                <span>e</span>Tickets
            </a>

            <p>
                Curated cinema experiences, one ticket at a time.
            </p>

            <div>
                <a asp-controller="Movies"
                   asp-action="Index">
                    Movies
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>
            </div>

            <small>
                © 2026 eTickets
            </small>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
