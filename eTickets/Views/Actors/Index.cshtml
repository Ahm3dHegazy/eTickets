@model IEnumerable<Actor>
@{
    ViewData["Title"] = "Actors";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">Actors</h2>
        <a asp-controller="Actors" asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i> Create New Actor
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No actors found.</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var actor in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden">
                        <img src="@(string.IsNullOrEmpty(actor.ProfilePictureURL) ? Url.Content("~/images/actors/placeholder.png") : actor.ProfilePictureURL)"
                             alt="@actor.FullName"
                             class="card-img-top"
                             style="height:220px;object-fit:cover;" />

                        <div class="card-body text-center">
                            <h6 class="card-title mb-1">@actor.FullName</h6>
                            <p class="text-muted small mb-2" style="min-height:2.4rem;">
                                @{
                                    var bio = actor.Bio ?? "";
                                    var preview = bio.Length > 60 ? bio.Substring(0, 60) + "…" : bio;
                                }
                                @preview
                            </p>
                        </div>

                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center gap-2 pb-3">
                            <a asp-controller="Actors" asp-action="Details" asp-route-id="@actor.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-controller="Actors" asp-action="Edit" asp-route-id="@actor.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <form asp-controller="Actors" asp-action="Delete" asp-route-id="@actor.Id" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this actor?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>