<div class="actor-page">
    <div class="actor-photo-col">
        <img src="@(string.IsNullOrEmpty(Model.ProfilePictureURL) ? Url.Content("~/images/actors/placeholder.png") : Model.ProfilePictureURL)"
             alt="@Model.FullName" />
    </div>

    <div class="actor-content-col">
        <div class="breadcrumb-custom mb-2">
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i></a>
            <span>/</span>
            <a asp-controller="Actors" asp-action="Index">Actors</a>
            <span>/</span>
            <span class="text-white">@Model.FullName</span>
        </div>

        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h1 class="actor-name">@Model.FullName</h1>
                <div class="actor-subtitle">Actor Profile</div>
            </div>
            <div class="d-flex gap-2 mt-2">
                <a asp-controller="Actors" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-edit-custom px-3">
                    <i class="bi bi-pencil-fill me-1"></i> Edit
                </a>
                <a asp-controller="Actors" asp-action="Index" class="btn btn-showall-custom px-3">
                    <i class="bi bi-list-ul me-1"></i> Show All
                </a>
            </div>
        </div>

        <div class="section-heading">
            <span class="icon-circle"><i class="bi bi-person-fill"></i></span>
            BIOGRAPHY
        </div>
        <p class="bio-text">
            @(string.IsNullOrEmpty(Model.Bio) ? "No biography available." : Model.Bio)
        </p>

        @if (Model.Actor_Movies != null && Model.Actor_Movies.Any())
        {
            <div class="section-heading">
                <span class="icon-circle"><i class="bi bi-film"></i></span>
                FILMOGRAPHY
            </div>
            <div class="filmography-scroll">
                @foreach (var am in Model.Actor_Movies)
                {
                    <div class="film-card">
                        <img src="@(string.IsNullOrEmpty(am.Movie?.ImageURL) ? Url.Content("~/images/movies/placeholder.png") : am.Movie.ImageURL)"
                             alt="@am.Movie?.Name" />
                        <div class="film-title">@am.Movie?.Name</div>
                        <div class="film-meta">
                            <span class="badge-year">@am.Movie?.StartDate.Year</span>
                            @am.Movie?.MovieCategory
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>