@{ ViewData["Title"] = "Checkout"; }
<div class="checkout-shell"><div class="checkout-card"><i class="bi bi-ticket-perforated checkout-icon"></i><p class="section-kicker mt-3">Almost there</p><h1>Complete your booking</h1><p class="text-muted">Enter your details to place your order securely.</p><form asp-action="CreateFromCart" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label class="form-label" for="customerName">Full name</label><input class="form-control" id="customerName" name="customerName" autocomplete="name" required /></div><div class="mb-4"><label class="form-label" for="customerEmail">Email address</label><input class="form-control" id="customerEmail" name="customerEmail" type="email" autocomplete="email" required /></div><button class="btn btn-cinema w-100 py-2" type="submit">Place order <i class="bi bi-lock-fill ms-1"></i></button></form></div></div>
