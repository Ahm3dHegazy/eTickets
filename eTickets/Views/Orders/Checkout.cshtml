@inject eTickets.Business.Interfaces.IShoppingCartService CartService
@{ ViewData["Title"] = "Checkout"; var items = CartService.GetItems(); var total = items.Sum(item => item.Price * item.Quantity); var isPayPalConfigured = ViewData["PayPalConfigured"] as bool? == true; var clientId = ViewData["PayPalClientId"] as string; }
<div class="checkout-shell"><div class="checkout-card"><i class="bi bi-ticket-perforated checkout-icon"></i><p class="section-kicker mt-3">Secure checkout</p><h1>Complete your booking</h1><div class="checkout-total"><span>@items.Sum(item => item.Quantity) ticket(s)</span><strong>@total.ToString("C")</strong></div><form id="checkoutForm" class="mt-4">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label" for="customerName">Full name</label><input class="form-control" id="customerName" name="customerName" autocomplete="name" required /></div><div class="mb-4"><label class="form-label" for="customerEmail">Email address</label><input class="form-control" id="customerEmail" name="customerEmail" type="email" autocomplete="email" required /></div></form>@if (isPayPalConfigured){<div id="paypal-button-container"></div><p id="paymentMessage" class="small mt-3 mb-0" role="status"></p>}else{<div class="alert alert-warning mb-0">PayPal is not configured yet. Add your sandbox credentials to enable payments.</div>}</div></div>
@section Scripts {
    @if (isPayPalConfigured)
    {
        <script src="https://www.paypal.com/sdk/js?client-id=@clientId&currency=USD&intent=capture"></script>
        <script>
            const form = document.getElementById('checkoutForm'), message = document.getElementById('paymentMessage'), token = document.querySelector('[name="__RequestVerificationToken"]').value;
            const details = () => ({ customerName: document.getElementById('customerName').value, customerEmail: document.getElementById('customerEmail').value });
            const post = async (url, payload) => { const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify(payload) }), data = await response.json(); if (!response.ok) throw new Error(data.error || data.detail || 'Payment could not be processed.'); return data; };
            paypal.Buttons({ createOrder: async () => { if (!form.reportValidity()) throw new Error('Enter your details first.'); return (await post('@Url.Action("CreatePayPalOrder", "Orders")', details())).id; }, onApprove: async (data) => { const result = await post('@Url.Action("CapturePayPalOrder", "Orders")', { ...details(), payPalOrderId: data.orderID }); window.location.href = '@Url.Action("Details", "Orders")/' + result.orderId; }, onError: error => { message.className = 'text-danger small mt-3 mb-0'; message.textContent = error.message || 'PayPal could not complete the payment. Please try again.'; } }).render('#paypal-button-container');
        </script>
    }
}
