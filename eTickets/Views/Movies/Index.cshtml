@model IEnumerable<Movie>

@{
    var selectedCategory = ViewData["SelectedCategory"] as string;
    ViewData["Title"] = string.IsNullOrWhiteSpace(selectedCategory) ? "Movies" : $"{selectedCategory} Movies";
}

@section Styles {
    <link rel="stylesheet" href="~/css/movies-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/movie-poster-ratings.css" asp-append-version="true" />
}

<div class="container py-4">

     <div class="movies-header">

        <h2 class="movies-title">
            @(string.IsNullOrWhiteSpace(selectedCategory) ? "Movies" : $"{selectedCategory} Movies")
        </h2>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="Movies"
               asp-action="Add"
               class="btn-add-movie">
                <i class="bi bi-plus-lg"></i>

                Add New Movie
            </a>
        }
      
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No movies found in this category.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

            @foreach (var movie in Model)
            {
                var reviews = movie.Reviews ?? new List<eTickets.Data.Models.MovieReview>();
                var reviewCount = reviews.Count;
                var averageRating = reviewCount == 0 ? 0 : reviews.Average(review => review.Rating);
                <div class="col">

                    <div class="movie-card">
                         
                        <div class="movie-poster">

                            <img src="@(string.IsNullOrEmpty(movie.ImageURL)
                                                            ? Url.Content("~/images/movies/placeholder.png")
                                                            : movie.ImageURL)"
                                 alt="@movie.Name" />
 
                            @if (DateTime.Now < movie.StartDate)
                            {
                                <span class="movie-status status-upcoming">
                                    UPCOMING
                                </span>
                            }
                            else if (DateTime.Now <= movie.EndDate)
                            {
                                <span class="movie-status status-available">
                                    AVAILABLE
                                </span>
                            }
                            else
                            {
                                <span class="movie-status status-ended">
                                    ENDED
                                </span>
                            } 
                            <span class="poster-rating" aria-label="@(reviewCount == 0 ? "No ratings yet" : $"{averageRating:0.0} out of 5 stars from {reviewCount} reviews")">
                                <i class="bi bi-star-fill"></i>
                                @(reviewCount == 0 ? "New" : averageRating.ToString("0.0"))
                            </span>

                        </div>
                         
                        <div class="movie-card-body">
                             
                            <h5 class="movie-name">
                                @movie.Name
                            </h5>
                             
                            <div class="movie-category">
                                @movie.MovieCategory
                            </div>
                             
                            <p class="movie-description">

                                @{
                                    var desc = movie.Description ?? "";

                                    var preview = desc.Length > 90
                                        ? desc.Substring(0, 90) + "…"
                                        : desc;
                                }

                                @(string.IsNullOrWhiteSpace(preview)
                                    ? "No description available."
                                    : preview)

                            </p>
                             
                            <div class="movie-info">
                                 
                                <div class="movie-info-item">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        <strong>Cinema:</strong>
                                        @(movie.Cinema?.Name ?? "N/A")
                                    </span>

                                </div>
                                 
                                <div class="movie-info-item">

                                    <i class="bi bi-person"></i>

                                    <span>
                                        <strong>Producer:</strong>
                                        @(movie.Producer?.FullName ?? "N/A")
                                    </span>

                                </div>
                                 
                                <div class="movie-info-item">

                                    <i class="bi bi-calendar-event"></i>

                                    <span>
                                        <strong>Starts:</strong>
                                        @movie.StartDate.ToString("MMM dd, yyyy")
                                    </span>

                                </div>
                                 
                                <div class="movie-info-item">

                                    <i class="bi bi-calendar-event"></i>

                                    <span>
                                        <strong>Ends:</strong>
                                        @movie.EndDate.ToString("MMM dd, yyyy")
                                    </span>

                                </div>

                            </div>
                             
                            <div class="movie-price">

                                @movie.Price.ToString("C")

                            </div>
                             
                            <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="movieId" value="@movie.Id" />
                                <button type="submit" class="btn-add-cart">
                                    <i class="bi bi-cart-plus"></i>
                                    Add to Cart
                                </button>
                            </form> 
                            <div class="movie-actions">
                                <a asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="movie-action view"
                                   title="View movie details"
                                   aria-label="View details for @movie.Name">
                                    <i class="bi bi-arrow-up-right"></i>
                                </a>

                                @if (User.IsInRole("Administrator"))
                                {
                                <a asp-controller="Movies"
                                   asp-action="Edit"
                                   asp-route-id="@movie.Id"
                                   class="movie-action edit"
                                   title="Edit movie">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                <a asp-controller="Movies"
                                   asp-action="Delete"
                                   asp-route-id="@movie.Id"
                                   class="movie-action delete"
                                   title="Delete movie">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
