@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">Movies</h2>
        <a asp-controller="Movies" asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i> Add New Movie
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No movies found.</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden">
                        <span class="badge bg-primary position-absolute top-0 end-0 m-2">
                            @movie.MovieCategory
                        </span>

                        <img src="@(string.IsNullOrEmpty(movie.ImageURL) ? Url.Content("~/images/movies/placeholder.png") : movie.ImageURL)"
                             alt="@movie.Name"
                             class="card-img-top"
                             style="height:280px;object-fit:cover;" />

                        <div class="card-body">
                            <h6 class="card-title mb-1">@movie.Name</h6>
                            <p class="text-muted small mb-2" style="min-height:2.4rem;">
                                @{
                                    var desc = movie.Description ?? "";
                                    var preview = desc.Length > 70 ? desc.Substring(0, 70) + "…" : desc;
                                }
                                @preview
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-success">@movie.Price.ToString("C")</span>
                                <small class="text-muted">
                                    <i class="bi bi-building me-1"></i>@movie.Cinema?.Name
                                </small>
                            </div>
                            <small class="text-muted d-block">
                                <i class="bi bi-camera-reels me-1"></i>@movie.Producer?.FullName
                            </small>
                        </div>

                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center gap-2 pb-3">
                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-controller="Movies" asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <form asp-controller="Movies" asp-action="Delete" asp-route-id="@movie.Id" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this movie?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>