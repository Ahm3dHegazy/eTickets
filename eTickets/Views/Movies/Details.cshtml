@model Movie
@{
    ViewData["Title"] = Model.Name;
    var status = DateTime.Now < Model.StartDate ? "Coming soon" : DateTime.Now <= Model.EndDate ? "Now showing" : "Ended";
}

@section Styles { <link rel="stylesheet" href="~/css/movie-details.css" asp-append-version="true" /> }

<section class="movie-detail-hero" style="--poster: url('@Model.ImageURL');">
    <div class="movie-detail-backdrop"></div>
    <div class="movie-detail-content">
        <nav class="movie-breadcrumb" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill"></i></a><span>/</span><a asp-controller="Movies" asp-action="Index">Movies</a><span>/</span><strong>@Model.Name</strong></nav>
        <div class="movie-detail-grid">
            <aside class="movie-poster-wrap"><img src="@(string.IsNullOrEmpty(Model.ImageURL) ? Url.Content("~/images/movies/placeholder.png") : Model.ImageURL)" alt="@Model.Name" /><span class="movie-live-badge">@status</span></aside>
            <div class="movie-detail-main">
                <div class="movie-detail-topline"><span class="movie-genre">@Model.MovieCategory</span><span><i class="bi bi-star-fill"></i> Featured selection</span></div>
                <h1>@Model.Name</h1>
                <p class="movie-lead">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description available." : Model.Description)</p>
                <div class="movie-cta-row">
                    <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post"><input type="hidden" name="movieId" value="@Model.Id" /><button class="btn btn-cinema btn-lg" type="submit"><i class="bi bi-bag-plus"></i> Add to cart · @Model.Price.ToString("C")</button></form>
                    <a asp-controller="Movies" asp-action="Index" class="btn movie-back-btn"><i class="bi bi-arrow-left"></i> Browse movies</a>
                    @if (User.IsInRole("Administrator")) { <a asp-controller="Movies" asp-action="Edit" asp-route-id="@Model.Id" class="btn movie-edit-btn" aria-label="Edit @Model.Name"><i class="bi bi-pencil-fill"></i></a> }
                </div>
                <div class="movie-facts">
                    <div><i class="bi bi-calendar-event"></i><span>Showing from</span><strong>@Model.StartDate.ToString("MMM dd, yyyy")</strong></div>
                    <div><i class="bi bi-calendar-check"></i><span>Final showing</span><strong>@Model.EndDate.ToString("MMM dd, yyyy")</strong></div>
                    <div><i class="bi bi-building"></i><span>Cinema</span>@if (Model.Cinema != null) { <a asp-controller="Cinemas" asp-action="Details" asp-route-id="@Model.CinemaId">@Model.Cinema.Name</a> } else { <strong>N/A</strong> }</div>
                    <div><i class="bi bi-camera-reels"></i><span>Producer</span>@if (Model.Producer != null) { <a asp-controller="Producers" asp-action="Details" asp-route-id="@Model.ProducerId">@Model.Producer.FullName</a> } else { <strong>N/A</strong> }</div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Actor_Movies != null && Model.Actor_Movies.Any())
{
    <section class="movie-cast-section"><div class="movie-section-heading"><p>Meet the cast</p><h2>On screen</h2></div><div class="movie-cast-grid">@foreach (var am in Model.Actor_Movies) { <a asp-controller="Actors" asp-action="Details" asp-route-id="@am.ActorId" class="movie-cast-card"><img src="@(string.IsNullOrEmpty(am.Actor?.ProfilePictureURL) ? Url.Content("~/images/actors/placeholder.png") : am.Actor.ProfilePictureURL)" alt="@am.Actor?.FullName" /><span><strong>@am.Actor?.FullName</strong><small>View profile <i class="bi bi-arrow-up-right"></i></small></span></a> }</div></section>
}
