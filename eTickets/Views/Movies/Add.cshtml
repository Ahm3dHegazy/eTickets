
@model CreateMovieViewModel

@{
    ViewData["Title"] = "Add a new movie";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header border-0 pt-4 px-4">
                    <h3 class="mb-1">Add New Movie</h3>
                    <p class="text-muted mb-0">Fill in the movie's details below.</p>
                </div>

                <div class="card-body px-4 pb-4">
                    <form asp-action="Add" asp-controller="Movies" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3 text-center">
                            <img id="ImagePreview"
                                 class="w-50 rounded border d-none"
                                 style="aspect-ratio: 2 / 3; object-fit: cover; object-position: top center;" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageURL" class="form-label fw-semibold"></label>
                            <input asp-for="ImageURL" class="form-control" placeholder="https://example.com/poster.jpg" />
                            <span asp-validation-for="ImageURL" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Action Blast" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Movie synopsis..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold"></label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="e.g. 12.50" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MovieCategory" class="form-label fw-semibold"></label>
                                <select asp-for="MovieCategory" class="form-select" asp-items="Html.GetEnumSelectList<MovieCategory>()">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="MovieCategory" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label fw-semibold"></label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label fw-semibold"></label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CinemaId" class="form-label fw-semibold"></label>
                            <select asp-for="CinemaId" class="form-select"
                                    asp-items="@(new SelectList(Model.Cinemas, "Id", "Name"))">
                                <option value="">-- Select Cinema --</option>
                            </select>
                            <span asp-validation-for="CinemaId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProducerId" class="form-label fw-semibold"></label>
                            <select asp-for="ProducerId" class="form-select"
                                    asp-items="@(new SelectList(Model.Producers, "Id", "FullName"))">
                                <option value="">-- Select Producer --</option>
                            </select>
                            <span asp-validation-for="ProducerId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SelectedActorIds" class="form-label fw-semibold">Actors</label>
                            <select asp-for="SelectedActorIds" class="form-select" multiple size="6"
                                    asp-items="@(new MultiSelectList(Model.Actors, "Id", "FullName"))">
                            </select>
                            <div class="form-text">Hold Ctrl (Cmd on Mac) to select multiple actors.</div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Add Movie
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function updatePreview() {
            var preview = document.getElementById('ImagePreview');
            var url = $("#ImageURL").val();
            if (url) {
                preview.src = url;
                preview.classList.remove('d-none');
            } else {
                preview.classList.add('d-none');
            }
        }

        $(document).ready(updatePreview);
        $("#ImageURL").on("input", updatePreview);
    </script>
}
