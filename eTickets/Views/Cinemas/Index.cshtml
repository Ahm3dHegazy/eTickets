@model IEnumerable<Cinema>
@{
    ViewData["Title"] = "Cinemas";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">Cinemas</h2>
        <a asp-controller="Cinemas" asp-action="Add" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i> Add New Cinema
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No cinemas found.</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var cinema in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden">
                        <img src="@(string.IsNullOrEmpty(cinema.Logo) ? Url.Content("~/images/cinemas/placeholder.png") : cinema.Logo)"
                             alt="@cinema.Name"
                             class="card-img-top"
                             style="height:220px;object-fit:cover;" />

                        <div class="card-body text-center">
                            <h6 class="card-title mb-1">@cinema.Name</h6>
                            <p class="text-muted small mb-2" style="min-height:2.4rem;">
                                @{
                                    var bio = cinema.Description ?? "";
                                    var preview = bio.Length > 60 ? bio.Substring(0, 60) + "…" : bio;
                                }
                                @preview
                            </p>
                        </div>

                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center gap-2 pb-3">
                            <a asp-controller="Cinemas" asp-action="Details" asp-route-id="@cinema.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-controller="Cinemas" asp-action="Edit" asp-route-id="@cinema.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-controller="Cinemas"
                               asp-action="Delete"
                               asp-route-id="@cinema.Id"
                               class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>