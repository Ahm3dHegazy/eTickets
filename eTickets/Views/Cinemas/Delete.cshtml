@model Cinema
@{
    ViewData["Title"] = "Delete Cinema";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header border-0 pt-4 px-4">
                    <h3 class="mb-1 text-danger">Delete Cinema</h3>
                    <p class="text-muted mb-0">Are you sure you want to delete this cinema?</p>
                </div>

                <div class="card-body px-4 pb-4">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="d-flex gap-3 align-items-center mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.Logo) ? Url.Content("~/images/Cinemas/placeholder.png") : Model.Logo)"
                             alt="@Model.Name"
                             style="width:80px;height:120px;object-fit:cover;border-radius:6px;" />
                        <div>
                            <h5 class="mb-1">@Model.Name</h5>
                            <p class="text-muted small mb-0">@Model.Description</p>
                        </div>
                    </div>

                    <form asp-controller="Cinemas" asp-action="Delete" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this cinema? This action cannot be undone.');">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-1"></i> Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>